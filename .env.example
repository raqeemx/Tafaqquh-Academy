# Copy the web app configuration from Firebase Console. Never put private keys here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tafaqquh-academy
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Enable only after Email/Password, Firestore and reviewed rules are ready.
NEXT_PUBLIC_FIREBASE_AUTH_ENABLED=false
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=false
# Server only. Use Application Default Credentials, not inline private keys.
FIREBASE_PROJECT_ID=tafaqquh-academy
FIREBASE_ADMIN_ENABLED=false
FIREBASE_USE_EMULATORS=false
# Optional LOCAL path outside the repository, never the file contents:
# GOOGLE_APPLICATION_CREDENTIALS=
# Emulator-only, leave unset when using real Firebase:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Environment separation: local | staging | production
APP_ENV=local
NEXT_PUBLIC_APP_ENV=local
# Required for staging; must be distinct from tafaqquh-academy.
FIREBASE_STAGING_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STAGING_PROJECT_ID=
# Exact public origin for authenticated administrative POST requests.
APP_ORIGIN=http://localhost:3000
# Set only after management reviews the text and fills all three fields.
NEXT_PUBLIC_PRIVACY_POLICY_APPROVED=false
NEXT_PUBLIC_PRIVACY_CONTROLLER=
NEXT_PUBLIC_PRIVACY_CONTACT=
NEXT_PUBLIC_PRIVACY_RETENTION=
# Drive is read-only and disabled until explicit permission is granted.
DRIVE_ENABLED=false
DRIVE_MEDIA_ENABLED=false
DRIVE_AUTH_MODE=adc
# Server-only OAuth alternative, provision only after explicit owner consent.
DRIVE_OAUTH_CLIENT_ID=
DRIVE_OAUTH_CLIENT_SECRET=
DRIVE_OAUTH_REFRESH_TOKEN=
# Playback bounds per file and per student per UTC hour. Never NEXT_PUBLIC.
DRIVE_MAX_FILE_BYTES=10737418240
PLAYBACK_HOURLY_BYTES=2147483648
PLAYBACK_HOURLY_REQUESTS=600
DRIVE_PROVIDER=google
# Comma-separated approved folder IDs; never a credential.
DRIVE_ALLOWED_ROOTS=
