# Copy the web app configuration from Firebase Console. Never put private keys here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tafaqquh-academy
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Enable only after Email/Password, Firestore and reviewed rules are ready.
NEXT_PUBLIC_FIREBASE_AUTH_ENABLED=false
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=false
# Server only. Use Application Default Credentials, not inline private keys.
FIREBASE_PROJECT_ID=tafaqquh-academy
FIREBASE_ADMIN_ENABLED=false
FIREBASE_USE_EMULATORS=false
# Optional LOCAL path outside the repository, never the file contents:
# GOOGLE_APPLICATION_CREDENTIALS=
# Emulator-only, leave unset when using real Firebase:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
