{
  "name": "tafaqquh-academy",
  "version": "0.1.0",
  "description": "Arabic Islamic Learning Management Platform",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-staging.mjs && next build",
    "test:config": "node --test tests/config/*.test.mjs",
    "test:staging": "playwright test --config playwright.staging.config.ts",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:rules": "firebase emulators:exec --only auth,firestore --project demo-tafaqquh \"node --test --test-force-exit --test-concurrency=1 tests/security/*.test.mjs\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-tafaqquh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raqeemx/Tafaqquh-Academy.git"
  },
  "keywords": [],
  "author": "",
  "bugs": {
    "url": "https://github.com/raqeemx/Tafaqquh-Academy/issues"
  },
  "homepage": "https://github.com/raqeemx/Tafaqquh-Academy#readme",
  "dependencies": {
    "firebase": "13.1.0",
    "firebase-admin": "14.5.0",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "firebase-tools": "15.34.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  }
}
