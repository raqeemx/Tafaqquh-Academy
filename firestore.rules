rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function approved() {
      return request.auth != null && request.auth.token.email_verified == true
        && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.status == 'approved';
    }
    match /students/{uid} {
      allow get: if owner(uid);
      allow list: if false;
      allow create: if owner(uid)
        && request.resource.data.keys().hasAll(['uid', 'email', 'displayName', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      // Admission decisions and profile changes are trusted-server-only.
      allow update, delete: if false;
    }
    match /restrictedContent/{contentId} {
      allow read: if approved() && resource.data.published == true;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
